{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "rgBaseName": {
      "type": "string",
      "defaultValue": "tareq-rabad-azure-functions",
      "minLength": 3,
      "maxLength": 80,
      "metadata": {
        "description": "Base resource group name used before the autogenerated subscription suffix."
      }
    },
    "rgLocation": {
      "type": "string",
      "defaultValue": "eastus",
      "metadata": {
        "description": "Azure region for the resource group and all resources."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "pf",
      "minLength": 2,
      "maxLength": 11,
      "metadata": {
        "description": "Lowercase letters/numbers prefix used for globally unique names. Keep this short so storage account names stay within 24 characters."
      }
    },
    "functionRuntimeVersion": {
      "type": "string",
      "defaultValue": "8.0",
      "allowedValues": [
        "8.0",
        "10.0"
      ],
      "metadata": {
        "description": "Runtime version for dotnet-isolated Function App."
      }
    }
  },
  "variables": {
    "resourceGroupName": "[concat(parameters('rgBaseName'), '-', substring(toLower(uniqueString(subscription().subscriptionId)), 0, 6))]",
    "nameSeed": "[toLower(uniqueString(subscription().subscriptionId, variables('resourceGroupName'), parameters('namePrefix')))]",
    "safePrefix": "[toLower(replace(parameters('namePrefix'), '-', ''))]",
    "storageNameBase": "[concat(variables('safePrefix'), 'st', variables('nameSeed'))]",
    "storageAccountName": "[if(greater(length(variables('storageNameBase')), 24), substring(variables('storageNameBase'), 0, 24), variables('storageNameBase'))]",
    "functionAppName": "[concat(variables('safePrefix'), '-func-', variables('nameSeed'))]",
    "appInsightsName": "[concat(variables('safePrefix'), '-appi-', variables('nameSeed'))]",
    "planName": "[concat(variables('safePrefix'), '-fc-', variables('nameSeed'))]",
    "workspaceName": "[concat(variables('safePrefix'), '-law-', variables('nameSeed'))]",
    "deploymentContainerName": "[concat('app-package-', variables('nameSeed'))]",
    "queueName": "test-items-queue"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[variables('resourceGroupName')]",
      "location": "[parameters('rgLocation')]",
      "properties": {}
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "portfolioInfraDeployment",
      "resourceGroup": "[variables('resourceGroupName')]",
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "location": {
            "value": "[parameters('rgLocation')]"
          },
          "storageAccountName": {
            "value": "[variables('storageAccountName')]"
          },
          "functionAppName": {
            "value": "[variables('functionAppName')]"
          },
          "appInsightsName": {
            "value": "[variables('appInsightsName')]"
          },
          "planName": {
            "value": "[variables('planName')]"
          },
          "workspaceName": {
            "value": "[variables('workspaceName')]"
          },
          "deploymentContainerName": {
            "value": "[variables('deploymentContainerName')]"
          },
          "queueName": {
            "value": "[variables('queueName')]"
          },
          "functionRuntimeVersion": {
            "value": "[parameters('functionRuntimeVersion')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "location": {
              "type": "string"
            },
            "storageAccountName": {
              "type": "string"
            },
            "functionAppName": {
              "type": "string"
            },
            "appInsightsName": {
              "type": "string"
            },
            "planName": {
              "type": "string"
            },
            "workspaceName": {
              "type": "string"
            },
            "deploymentContainerName": {
              "type": "string"
            },
            "queueName": {
              "type": "string"
            },
            "functionRuntimeVersion": {
              "type": "string"
            }
          },
          "variables": {
            "deploymentStorageUrl": "[concat('https://', parameters('storageAccountName'), '.blob.', environment().suffixes.storage, '/', parameters('deploymentContainerName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2023-05-01",
              "name": "[parameters('storageAccountName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Standard_LRS"
              },
              "kind": "StorageV2",
              "properties": {
                "minimumTlsVersion": "TLS1_2",
                "allowBlobPublicAccess": false,
                "supportsHttpsTrafficOnly": true,
                "allowSharedKeyAccess": true,
                "networkAcls": {
                  "bypass": "AzureServices",
                  "defaultAction": "Allow",
                  "ipRules": [],
                  "virtualNetworkRules": []
                },
                "accessTier": "Hot",
                "encryption": {
                  "keySource": "Microsoft.Storage",
                  "services": {
                    "blob": {
                      "enabled": true
                    },
                    "file": {
                      "enabled": true
                    }
                  }
                }
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices",
              "apiVersion": "2023-05-01",
              "name": "[concat(parameters('storageAccountName'), '/default')]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ],
              "properties": {
                "cors": {
                  "corsRules": []
                },
                "deleteRetentionPolicy": {
                  "enabled": true,
                  "days": 7
                }
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/queueServices",
              "apiVersion": "2023-05-01",
              "name": "[concat(parameters('storageAccountName'), '/default')]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ],
              "properties": {
                "cors": {
                  "corsRules": []
                }
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2023-05-01",
              "name": "[concat(parameters('storageAccountName'), '/default/', parameters('deploymentContainerName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
              ],
              "properties": {
                "publicAccess": "None"
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2023-05-01",
              "name": "[concat(parameters('storageAccountName'), '/default/azure-webjobs-hosts')]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
              ],
              "properties": {
                "publicAccess": "None"
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2023-05-01",
              "name": "[concat(parameters('storageAccountName'), '/default/azure-webjobs-secrets')]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
              ],
              "properties": {
                "publicAccess": "None"
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/queueServices/queues",
              "apiVersion": "2023-05-01",
              "name": "[concat(parameters('storageAccountName'), '/default/', parameters('queueName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/queueServices', parameters('storageAccountName'), 'default')]"
              ],
              "properties": {
                "metadata": {}
              }
            },
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2023-09-01",
              "name": "[parameters('workspaceName')]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30,
                "features": {
                  "enableLogAccessUsingOnlyResourcePermissions": true
                }
              }
            },
            {
              "type": "microsoft.insights/components",
              "apiVersion": "2020-02-02",
              "name": "[parameters('appInsightsName')]",
              "location": "[parameters('location')]",
              "kind": "web",
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
              ],
              "properties": {
                "Application_Type": "web",
                "Flow_Type": "Bluefield",
                "Request_Source": "rest",
                "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
                "IngestionMode": "LogAnalytics",
                "RetentionInDays": 90,
                "publicNetworkAccessForIngestion": "Enabled",
                "publicNetworkAccessForQuery": "Enabled"
              }
            },
            {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2024-04-01",
              "name": "[parameters('planName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "FC1",
                "tier": "FlexConsumption"
              },
              "kind": "functionapp,linux",
              "properties": {
                "reserved": true
              }
            },
            {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2024-04-01",
              "name": "[parameters('functionAppName')]",
              "location": "[parameters('location')]",
              "kind": "functionapp,linux",
              "identity": {
                "type": "SystemAssigned"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
                "[resourceId('microsoft.insights/components', parameters('appInsightsName'))]"
              ],
              "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
                "httpsOnly": true,
                "publicNetworkAccess": "Enabled",
                "siteConfig": {
                  "appSettings": [
                    {
                      "name": "FUNCTIONS_EXTENSION_VERSION",
                      "value": "~4"
                    },
                    {
                      "name": "AzureWebJobsStorage",
                      "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value)]"
                    },
                    {
                      "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                      "value": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
                    },
                    {
                      "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                      "value": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2020-02-02').InstrumentationKey]"
                    },
                    {
                      "name": "DEPLOYMENT_STORAGE_CONNECTION_STRING",
                      "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value)]"
                    }
                  ]
                },
                "functionAppConfig": {
                  "runtime": {
                    "name": "dotnet-isolated",
                    "version": "[parameters('functionRuntimeVersion')]"
                  },
                  "deployment": {
                    "storage": {
                      "type": "blobContainer",
                      "value": "[variables('deploymentStorageUrl')]",
                      "authentication": {
                        "type": "StorageAccountConnectionString",
                        "storageAccountConnectionStringName": "DEPLOYMENT_STORAGE_CONNECTION_STRING"
                      }
                    }
                  },
                  "scaleAndConcurrency": {
                    "maximumInstanceCount": 100,
                    "instanceMemoryMB": 512
                  }
                }
              }
            }
          ],
          "outputs": {
            "functionAppName": {
              "type": "string",
              "value": "[parameters('functionAppName')]"
            },
            "storageAccountName": {
              "type": "string",
              "value": "[parameters('storageAccountName')]"
            },
            "appInsightsName": {
              "type": "string",
              "value": "[parameters('appInsightsName')]"
            },
            "planName": {
              "type": "string",
              "value": "[parameters('planName')]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[variables('resourceGroupName')]"
    },
    "resourceGroupLocation": {
      "type": "string",
      "value": "[parameters('rgLocation')]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[variables('appInsightsName')]"
    },
    "hostingPlanName": {
      "type": "string",
      "value": "[variables('planName')]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[variables('workspaceName')]"
    }
  }
}
